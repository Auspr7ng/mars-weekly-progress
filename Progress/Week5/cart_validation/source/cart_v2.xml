<mujoco model="flatbed_cart">

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <geom friction="0.8 0.01 0.001" condim="3"/>
    <joint damping="0.1" frictionloss="0.05"/>
  </default>

  <worldbody>

    <body name="cart" pos="0 0 0">
      <freejoint name="cart_free"/>

      <!-- ===== PLATFORM =====
           220mm(L) x 310mm(W) x 10mm(T)
           Bottom at: wheel_center(25.4mm) + housing(50.8mm) = 76.2mm from floor
           Center z:  76.2 + 5 = 81.2mm = 0.0812m -->
      <geom name="platform" type="box"
            size="0.110 0.155 0.005"
            pos="0 0 0.0812"
            rgba="0.52 0.11 0.07 1"
            mass="5"/>

      <!-- ===== HANDLE =====
           Tube radius: 10mm
           Arms: rear edge (x=-0.110), 10mm outside side edges (y=±0.165)
           Grip bar: 10cm behind rear edge (x=-0.210), 19.5cm from floor (z=0.195) -->
      <geom name="arm_l" type="cylinder" size="0.010"
            fromto="-0.110  0.165 0.0862    -0.210  0.155 0.195"
            rgba="0.08 0.08 0.08 1"/>
      <geom name="arm_r" type="cylinder" size="0.010"
            fromto="-0.110 -0.165 0.0862    -0.210 -0.155 0.195"
            rgba="0.08 0.08 0.08 1"/>
      <geom name="grip" type="cylinder" size="0.010"
            fromto="-0.210 -0.155 0.195    -0.210  0.155 0.195"
            rgba="0.08 0.08 0.08 1"/>
      <geom name="cap_l" type="sphere" size="0.010"
            pos="-0.210  0.155 0.195" rgba="0.08 0.08 0.08 1"/>
      <geom name="cap_r" type="sphere" size="0.010"
            pos="-0.210 -0.155 0.195" rgba="0.08 0.08 0.08 1"/>

      <!-- Grasp sites for robot hand weld constraints -->
      <site name="handle_left"  pos="-0.210  0.08 0.195" size="0.012" rgba="0 1 0 0.4"/>
      <site name="handle_right" pos="-0.210 -0.08 0.195" size="0.012" rgba="1 0 0 0.4"/>

      <!-- ===== SWIVEL CASTERS =====
           Wheel radius:      1"    = 0.0254m
           Wheel half-width:  0.5"  = 0.0127m
           Housing height:    2"    = 0.0508m  (wheel center to swivel pin)
           Swivel pin z:      0.0254 + 0.0508  = 0.0762m from floor

           Wheel X (from cart center): 0.110 - 0.0254 = 0.0846m
           Wheel Y (from cart center): 0.155 - 0.0381 = 0.1169m

           Wheel body relative to swivel pin:
             x = +0.015m  (fork trail for self-alignment)
             z = -0.0508m (drop to wheel center) -->

      <!-- Front-left -->
      <body name="caster_fl" pos=" 0.0846  0.1169 0.0762">
        <joint name="j_swivel_fl" type="hinge" axis="0 0 1"
               damping="0.8" frictionloss="0.2"/>
        <body name="wheel_fl" pos="0.015 0 -0.0508">
          <joint name="j_roll_fl" type="hinge" axis="0 1 0"
                 damping="0.05" frictionloss="0.02"/>
          <geom type="cylinder" size="0.0254 0.0127"
                euler="90 0 0"
                friction="0.9 0.005 0.001"
                condim="3" mass="0.2"
                rgba="0.32 0.32 0.32 1"/>
        </body>
      </body>

      <!-- Front-right -->
      <body name="caster_fr" pos=" 0.0846 -0.1169 0.0762">
        <joint name="j_swivel_fr" type="hinge" axis="0 0 1"
               damping="0.8" frictionloss="0.2"/>
        <body name="wheel_fr" pos="0.015 0 -0.0508">
          <joint name="j_roll_fr" type="hinge" axis="0 1 0"
                 damping="0.05" frictionloss="0.02"/>
          <geom type="cylinder" size="0.0254 0.0127"
                euler="90 0 0"
                friction="0.9 0.005 0.001"
                condim="3" mass="0.2"
                rgba="0.32 0.32 0.32 1"/>
        </body>
      </body>

      <!-- Rear-left -->
      <body name="caster_rl" pos="-0.0846  0.1169 0.0762">
        <joint name="j_swivel_rl" type="hinge" axis="0 0 1"
               damping="0.8" frictionloss="0.2"/>
        <body name="wheel_rl" pos="0.015 0 -0.0508">
          <joint name="j_roll_rl" type="hinge" axis="0 1 0"
                 damping="0.05" frictionloss="0.02"/>
          <geom type="cylinder" size="0.0254 0.0127"
                euler="90 0 0"
                friction="0.9 0.005 0.001"
                condim="3" mass="0.2"
                rgba="0.32 0.32 0.32 1"/>
        </body>
      </body>

      <!-- Rear-right -->
      <body name="caster_rr" pos="-0.0846 -0.1169 0.0762">
        <joint name="j_swivel_rr" type="hinge" axis="0 0 1"
               damping="0.8" frictionloss="0.2"/>
        <body name="wheel_rr" pos="0.015 0 -0.0508">
          <joint name="j_roll_rr" type="hinge" axis="0 1 0"
                 damping="0.05" frictionloss="0.02"/>
          <geom type="cylinder" size="0.0254 0.0127"
                euler="90 0 0"
                friction="0.9 0.005 0.001"
                condim="3" mass="0.2"
                rgba="0.32 0.32 0.32 1"/>
        </body>
      </body>

    </body>

  </worldbody>

  <!-- ===== ROBOT HAND CONSTRAINTS (uncomment when merging with robot XML) =====
  <equality>
    <weld name="weld_left"
          body1="left_hand"  site1="left_hand_site"
          body2="cart"       site2="handle_left"
          active="true"/>
    <weld name="weld_right"
          body1="right_hand" site1="right_hand_site"
          body2="cart"       site2="handle_right"
          active="true"/>
  </equality>
  -->

</mujoco>